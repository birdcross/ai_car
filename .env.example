COPA_API_KEY=
EVLOG_MODEL=claude-haiku-4

# 선택: 이미지를 받는 모델을 따로 지정할 때
# EVLOG_VISION_MODEL=claude-haiku-4

# 선택: Supabase Auth 및 벡터 검색을 서버 환경 변수로 설정할 때
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# 현대 블루링크 개발자 프로젝트를 사용할 때만 설정
# HYUNDAI_CLIENT_ID=
# HYUNDAI_CLIENT_SECRET=
# HYUNDAI_REDIRECT_URI=http://127.0.0.1:8000/vehicle-connect/callback

# CODEF 공식 샌드박스 조회를 사용할 때만 설정
# CODEF_SANDBOX_CLIENT_ID=
# CODEF_SANDBOX_CLIENT_SECRET=
