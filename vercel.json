{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "dist",
  "functions": {
    "api/evlog.py": { "includeFiles": "{server.py,manual_rag.py,manual_embeddings.py,vehicle_connect.py,vehicle_oauth_store.py,data/**,dist/index.html}", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:endpoint(auth-config|guide|cards|vehicle-connect)", "destination": "/api/evlog?evlog_route=:endpoint" },
    { "source": "/vehicle-connect/callback", "destination": "/api/evlog?evlog_route=callback" }
  ]
}
